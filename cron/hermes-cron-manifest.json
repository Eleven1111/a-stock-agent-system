{
  "version": "1.0",
  "description": "A股Agent系统 Cron Manifest — 所有定时任务定义",
  "timezone": "Asia/Shanghai",
  "jobs": [
    {
      "id": "global-preopen",
      "name": "全球市场盘前扫描",
      "schedule": "15 8 * * 1-5",
      "timezone": "Asia/Shanghai",
      "command": "python skills/global-market-monitor/scripts/monitor.py --json",
      "cwd": ".",
      "enabled": true,
      "silent_when_no_signal": false,
      "expected_output": "json",
      "external": true,
      "external_note": "需 Hermes Agent cron 运行时；依赖 yfinance (Yahoo Finance)"
    },
    {
      "id": "global-evening",
      "name": "全球市场晚间扫描",
      "schedule": "30 22 * * 1-5",
      "timezone": "Asia/Shanghai",
      "command": "python skills/global-market-monitor/scripts/monitor.py --json",
      "cwd": ".",
      "enabled": true,
      "silent_when_no_signal": false,
      "expected_output": "json",
      "external": true,
      "external_note": "需 Hermes Agent cron 运行时"
    },
    {
      "id": "intraday-alert",
      "name": "盘中异动监控（5分钟）",
      "schedule": "*/5 9-11,13-14 * * 1-5",
      "timezone": "Asia/Shanghai",
      "command": "python skills/stock-triage/scripts/intraday_monitor.py --json",
      "cwd": ".",
      "enabled": true,
      "silent_when_no_signal": true,
      "expected_output": "json",
      "external": true,
      "external_note": "需 Hermes Agent cron 运行时；只输出告警，无告警静默。脚本内置交易时段守卫(9:30-11:30/13:00-15:00)，盘前盘后自动静默退出"
    },
    {
      "id": "capital-flow",
      "name": "资金流向监控",
      "schedule": "30 10,14 * * 1-5",
      "timezone": "Asia/Shanghai",
      "command": "python skills/stock-triage/scripts/capital_flow_monitor.py --json",
      "cwd": ".",
      "enabled": true,
      "silent_when_no_signal": false,
      "expected_output": "json",
      "external": true,
      "external_note": "需 Hermes Agent + NO_PROXY 环境（东财 API）"
    },
    {
      "id": "hk-a-linkage",
      "name": "港A联动监控",
      "schedule": "45 9,13,14 * * 1-5",
      "timezone": "Asia/Shanghai",
      "command": "python skills/stock-triage/scripts/hk_a_linkage.py --json",
      "cwd": ".",
      "enabled": true,
      "silent_when_no_signal": false,
      "expected_output": "json",
      "external": true,
      "external_note": "需 Hermes Agent cron 运行时"
    },
    {
      "id": "four-dim-scorer",
      "name": "收盘四维打分",
      "schedule": "8 15 * * 1-5",
      "timezone": "Asia/Shanghai",
      "command": "python skills/stock-triage/scripts/four_dim_scorer.py {code} {name} --json",
      "cwd": ".",
      "enabled": true,
      "silent_when_no_signal": false,
      "expected_output": "json",
      "template_vars": ["code", "name"],
      "external": true,
      "external_note": "需 Hermes Agent cron 运行时；{code} {name} 由 cron prompt 动态替换"
    },
    {
      "id": "portfolio-check",
      "name": "持仓风控检查",
      "schedule": "10 15 * * 1-5",
      "timezone": "Asia/Shanghai",
      "command": "python skills/stock-triage/scripts/portfolio_manager.py --check --json",
      "cwd": ".",
      "enabled": true,
      "silent_when_no_signal": false,
      "expected_output": "json",
      "external": true,
      "external_note": "需 Hermes Agent cron 运行时"
    },
    {
      "id": "news-monitor",
      "name": "资讯监控 — 政策/产业/地缘触发",
      "schedule": "0 9,11,13,14,15,20,22 * * 1-5",
      "timezone": "Asia/Shanghai",
      "command": "python skills/news-to-sector/scripts/main.py {query}",
      "cwd": ".",
      "enabled": true,
      "silent_when_no_signal": true,
      "expected_output": "text",
      "template_vars": ["query"],
      "external": true,
      "external_note": "需 Hermes Agent + SerpAPI；无触发静默"
    },
    {
      "id": "institution-weekly",
      "name": "机构行为追踪（周报）",
      "schedule": "0 10 * * 6",
      "timezone": "Asia/Shanghai",
      "command": "python skills/stock-triage/scripts/institution_tracker.py --json",
      "cwd": ".",
      "enabled": true,
      "silent_when_no_signal": false,
      "expected_output": "json",
      "external": true,
      "external_note": "需 Hermes Agent + NO_PROXY（东财数据中心）"
    },
    {
      "id": "event-calendar",
      "name": "事件日历提醒",
      "schedule": "0 8 * * 1",
      "timezone": "Asia/Shanghai",
      "command": "python skills/stock-triage/scripts/event_calendar.py --json",
      "cwd": ".",
      "enabled": true,
      "silent_when_no_signal": true,
      "expected_output": "json",
      "external": true,
      "external_note": "需 Hermes Agent + NO_PROXY；无事件静默"
    },
    {
      "id": "performance-weekly",
      "name": "胜率统计（周报）",
      "schedule": "0 10 * * 7",
      "timezone": "Asia/Shanghai",
      "command": "python skills/stock-triage/scripts/performance_tracker.py --json",
      "cwd": ".",
      "enabled": true,
      "silent_when_no_signal": false,
      "expected_output": "json",
      "external": true,
      "external_note": "需 Hermes Agent cron 运行时"
    }
  ],
  "external_dependencies": {
    "hermes_agent": "Cron 调度运行时",
    "serpapi": "新闻搜索 API key",
    "feishu": "飞书 CLI（lark-cli）— 仅 serenity_to_feishu.py",
    "builderpulse": "社会情绪数据（不在本仓库）",
    "pulse_engine": "社会情绪日报（不在本仓库）"
  }
}
