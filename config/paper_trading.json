{
  "schema": "paper_trading_config_v1",
  "version": "paper-chanlun-gate-v1",
  "runtime": {
    "mode": "paper_only",
    "real_broker_access": false,
    "real_runtime_allowed_default": false,
    "paper_live_requires_explicit_switch": true
  },
  "account": {
    "initial_cash": 100000.0,
    "lot_size": 100,
    "max_positions": 5,
    "cash_buffer_pct": 5.0
  },
  "entry_gate": {
    "minimum_open_score": 80.0,
    "positive_recommendations": [
      "buy",
      "add",
      "conditional_buy"
    ],
    "bullish_chanlun_types": [
      "third_buy",
      "bottom_divergence"
    ],
    "bearish_chanlun_types": [
      "third_sell",
      "top_divergence"
    ],
    "max_signal_age_bars": 3
  },
  "execution": {
    "open_confirmation_not_before": "09:35:00",
    "maximum_quote_age_seconds": 120,
    "slippage_bps": 20.0
  },
  "position_risk": {
    "enabled": false,
    "risk_budget_pct": 0.75,
    "atr_multiple": 1.5,
    "stop_distance_pct_range": [3.0, 8.0],
    "leg_pct": 10.0,
    "max_single_position_pct": 30.0
  }
}
