        {"name": "gross_forward_return", "type": "float", "semantic": "forward_return", "unit": "decimal_return", "nullable": false},
        {"name": "net_forward_return", "type": "float", "semantic": "net_forward_return", "unit": "decimal_return", "nullable": false},
